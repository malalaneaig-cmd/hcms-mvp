{
  "name": "hcms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Healthcare Management System — MVP backend (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/seedDb.js",
    "db:reset": "node scripts/initDb.js && node scripts/seedDb.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  }
}
