# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=hcms

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173
