# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=hcms
# Runtime app connection (RLS-enforced — created by db/security.sql)
PGAPPUSER=hcms_app
PGAPPPASSWORD=hcms_app

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# ─── WhatsApp / SMS Chatbot ──────────────────────────────
# Provider: "local" (dev/testing) or "africala" (production)
WHATSAPP_PROVIDER=local
# Africala credentials (only needed when WHATSAPP_PROVIDER=africala)
# AFRICALA_API_URL=https://api.africala.net
# AFRICALA_API_KEY=your-api-key-here
# AFRICALA_WEBHOOK_SECRET=your-webhook-secret-here
# AFRICALA_SMS_SENDER_ID=CLINIC

# How often to scan for 24h appointment reminders (milliseconds)
REMINDER_INTERVAL_MS=900000

# ─── Booking window ──────────────────────────────────────
# Patient self-service (website, WhatsApp, SMS)
BOOKING_MAX_DAYS_PATIENT=30
# Staff-assisted (reception, phone)
BOOKING_MAX_DAYS_STAFF=90
BOOKING_MIN_LEAD_MINUTES_PATIENT=240
BOOKING_MIN_LEAD_MINUTES_STAFF=0
BOOKING_MAX_ACTIVE_PATIENT=1
CANCEL_CUTOFF_HOURS_PATIENT=24
RATE_LIMIT_PUBLIC_MAX=5
RATE_LIMIT_WEBHOOK_MAX=60
